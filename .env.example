# Copy to .env and fill in. Generate every value below with: npm run keys

# Web push (VAPID). Without these the app runs but delivers nothing.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:you@example.com

# Signs login cookies. Changing it signs everyone out.
SESSION_SECRET=

# The two logins. OWNER_CODE is hers, PARTNER_CODE is yours.
OWNER_CODE=
PARTNER_CODE=

# Default household timezone; also editable in the app's settings.
TZ_HOUSEHOLD=America/New_York

PORT=3000
NODE_ENV=production

# Set when running behind a reverse proxy (Fly, Render, nginx) so the login
# throttle can tell clients apart. Without it every request appears to come
# from the proxy and one stranger's wrong guesses would lock everyone out.
# Use 'true', a hop count, or a comma-separated list of trusted addresses.
# Leave unset when the process is directly internet-facing.
# TRUST_PROXY=true
